{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CPH Facility Dataset",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "dataStatus",
    "facilities"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "dataStatus": {
      "enum": [
        "demo",
        "production"
      ]
    },
    "facilities": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/facility"
      }
    }
  },
  "definitions": {
    "translation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "description",
        "address",
        "openingHours",
        "directions",
        "notes"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "description": {
          "type": "string"
        },
        "address": {
          "type": "string"
        },
        "openingHours": {
          "type": "string"
        },
        "directions": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true
    },
    "facility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "category",
        "isPublished",
        "lastVerifiedAt",
        "translations",
        "keywords",
        "englishPhrases"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 80
        },
        "category": {
          "enum": [
            "hotel",
            "dining",
            "cafe",
            "convenience",
            "pharmacy",
            "shopping",
            "attraction",
            "transportation",
            "sauna_spa",
            "atm"
          ]
        },
        "isPublished": {
          "type": "boolean"
        },
        "lastVerifiedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "translations": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ko",
            "en",
            "zh-CN",
            "ja"
          ],
          "properties": {
            "ko": {
              "$ref": "#/definitions/translation"
            },
            "en": {
              "$ref": "#/definitions/translation"
            },
            "zh-CN": {
              "$ref": "#/definitions/translation"
            },
            "ja": {
              "$ref": "#/definitions/translation"
            }
          }
        },
        "keywords": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ko",
            "en"
          ],
          "properties": {
            "ko": {
              "$ref": "#/definitions/keywords"
            },
            "en": {
              "$ref": "#/definitions/keywords"
            },
            "zh-CN": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "uniqueItems": true,
              "default": []
            },
            "ja": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "uniqueItems": true,
              "default": []
            }
          }
        },
        "englishPhrases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true
        },
        "walkingMinutes": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "default": null
        },
        "closedDays": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ko",
            "en",
            "zh-CN",
            "ja"
          ],
          "properties": {
            "ko": {
              "type": "string"
            },
            "en": {
              "type": "string"
            },
            "zh-CN": {
              "type": "string"
            },
            "ja": {
              "type": "string"
            }
          },
          "default": {
            "ko": "",
            "en": "",
            "zh-CN": "",
            "ja": ""
          }
        }
      }
    }
  }
}
