{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CPH Front Desk English Reply Scripts",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "dataStatus",
    "scripts"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "dataStatus": {
      "enum": [
        "demo",
        "production"
      ]
    },
    "scripts": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/script"
      }
    }
  },
  "definitions": {
    "bilingual": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "ko"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "ko": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "script": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "category",
        "title",
        "keywords",
        "question",
        "quickAnswer",
        "staffChecks",
        "sourceType",
        "sourceSection",
        "reviewStatus",
        "lastVerifiedAt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 85
        },
        "category": {
          "enum": [
            "check-in-out",
            "breakfast",
            "room-usage",
            "hotel-policy",
            "hotel-facilities"
          ]
        },
        "title": {
          "$ref": "#/definitions/text"
        },
        "keywords": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/text"
          }
        },
        "question": {
          "$ref": "#/definitions/bilingual"
        },
        "quickAnswer": {
          "$ref": "#/definitions/bilingual"
        },
        "details": {
          "$ref": "#/definitions/bilingual"
        },
        "staffChecks": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/text"
          }
        },
        "sourceType": {
          "enum": [
            "hotel-data",
            "user-provided"
          ]
        },
        "sourceSection": {
          "enum": [
            "name",
            "address",
            "checkIn",
            "checkOut",
            "breakfast",
            "parking",
            "roomUsage",
            "notes",
            null
          ]
        },
        "reviewStatus": {
          "enum": [
            "draft",
            "approved"
          ]
        },
        "lastVerifiedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "sourceType": {
                "const": "user-provided"
              }
            }
          },
          "then": {
            "properties": {
              "sourceSection": {
                "const": null
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "sourceType": {
                "const": "hotel-data"
              }
            }
          },
          "then": {
            "properties": {
              "sourceSection": {
                "type": "string"
              }
            }
          }
        }
      ]
    }
  }
}
