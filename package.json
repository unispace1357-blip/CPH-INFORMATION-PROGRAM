{
  "name": "cph-information-program",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run validate && tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "validate:data": "npm run validate",
    "test:data": "npm run test",
    "validate": "node scripts/validate-data.ts",
    "test": "tsc -p tsconfig.data.json && node --test scripts/*.test.ts",
    "validate:production": "node scripts/validate-production.ts",
    "build:production": "npm run validate:production && tsc -b && node scripts/build-production.ts",
    "test:ui": "node scripts/ui-smoke.cjs",
    "test:staff-ui": "node scripts/staff-ui-smoke.cjs",
    "test:guest-ui": "node scripts/guest-ui-smoke.cjs",
    "admin:dev": "vite --config vite.admin.config.ts",
    "admin:build": "tsc -p tsconfig.admin.json && vite build --config vite.admin.config.ts",
    "test:admin-ui": "node scripts/admin-ui-smoke.cjs"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
