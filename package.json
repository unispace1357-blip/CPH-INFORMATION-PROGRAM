{
  "name": "cph-information-program",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run validate && tsc -b && vite build",
    "build:public-test": "npm run validate && npm run validate:hotel-copy && tsc -b && node scripts/build-public-test.ts",
    "desktop:package": "npm run validate && npm run validate:hotel-copy && tsc -b && node scripts/package-desktop.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "validate": "node scripts/validate-data.ts",
    "test": "tsc -p tsconfig.data.json && node --test scripts/*.test.ts",
    "validate:production": "node scripts/validate-production.ts",
    "build:production": "node scripts/clean-production.ts && npm run validate:production && tsc -b && node scripts/build-production.ts",
    "validate:hotel-copy": "node scripts/validate-hotel-copy.ts",
    "test:ui": "node scripts/final-qa-ui.cjs",
    "admin:dev": "vite --config vite.admin.config.ts",
    "admin:build": "tsc -p tsconfig.admin.json && vite build --config vite.admin.config.ts"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@electron/get": "5.1.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "extract-zip": "2.0.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
